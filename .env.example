# Copy to .env and generate a NEW local password. Never reuse research credentials.
# Keep the password URL-safe because it is also used in DATABASE_URL.
POSTGRES_USER=spikelens
POSTGRES_PASSWORD=replace_with_new_random_urlsafe_password
POSTGRES_DB=spikelens
APP_ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
SESSION_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=20000
JOB_LEASE_SECONDS=120
MAX_JOB_ATTEMPTS=3
SUMMARY_CACHE_TTL=60
# Native-host development only. Compose replaces these with container DNS names.
DATABASE_URL=postgresql+psycopg://spikelens:replace_with_new_random_urlsafe_password@127.0.0.1:55440/spikelens
REDIS_URL=redis://127.0.0.1:56380/0
UPLOAD_DIR=./data/uploads
BACKEND_INTERNAL_URL=http://127.0.0.1:8100
