        "title": "AnalysisInput"
      },
      "Body_upload_api_v1_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_uploads_post"
      },
      "EventInput": {
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Ticker"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time"
          },
          "session": {
            "type": "string",
            "enum": [
              "PREMARKET",
              "RTH",
              "AFTERHOURS"
            ],
            "title": "Session"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "PRICE_SPIKE",
              "VOLUME_SURGE",
              "VOLATILITY"
            ],
            "title": "Event Type",
            "default": "PRICE_SPIKE"
          },
          "p0_price": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "P0 Price"
          },
          "t5_price": {
            "type": "number",
